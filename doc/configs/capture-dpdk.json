{
   "app_core":27,
   "handler":{      
      "no-pci": true,
      "no-telemetry": true,
      "eal_mbuf_size":65535,
      "eal_mbuf_headroom_size":0,                  
      "type":"dpdk",
      "promiscuous":true,
      "eal_cmd_line_arguments":[
         {
            "--main-lcore": 0
         },
         {
            "--lcores":"0,1,10"
         },     
         {
            "--vdev":"net_pcap0,rx_iface=wlx340a33e0dd2e,tx_pcap=/mnt/ramdisk/net_pcap0-tx.pcap"
         },
         {
            "--vdev":"net_pcap1,rx_pcap=/media/user/other/Pcap/rnd-pcaps/gtpu/gtpu_part_0.pcap,tx_pcap=/mnt/ramdisk/net_pcap1-tx.pcap"
         },         
         {  
         	"--file-prefix":"capture-app" 
         },
         {
            "--socket-mem": "1024,1024"
         },         
         {
            "--log-level":"lib.eal:debug"            
         },
         {
            "--log-level":"lib.mempool:debug"         
         }

      ],
      "mempools":[
         {
           "socket":0,
           "mbuf_size":32000,
           "mbuf_cache_size":256,
           "total_mbuf_num":2048
         },
         {
           "socket":1,
           "mbuf_size":32000,
           "mbuf_cache_size":256,
           "total_mbuf_num":2048
         }
      ],
      "workers":[
         {
            "type":"acl",
            "eal_core":1,
            "rx_device":"net_pcap1",
            "tx_device":"net_pcap1",            
            "rx_queues_idxs":{
               "type":"id",
               "indices":[
                  0
               ]
            },
            "tx_queues_idxs":{
               "type":"id",
               "indices":[
                  0
               ]
            },
            "input_packet_classification":[
               {
                  "type":"tuple5",
                  "action":"route",
                  "priority":1,
                  "rule":"R192.168.2.0/24 77.247.181.211/32 0 : 65535 0 : 65535 17/0xFF 0"
               },
               {
                  "type":"tuple5",
                  "action":"route",
                  "priority":2,
                  "rule":"R77.247.181.211/32 192.168.2.0/24 0 : 65535 0 : 65535 17/0xFF 0"
               }
            ]
         }
      ]
   },
   "transport":{
      "type":"file",
      "workdir":"/mnt/ramdisk",
      "use_zlib":false,
      "multiplexed":false,
      "buffer_type":"buffered",
      "protocol":"debug",
      "message_queue_size":3000000,
      "frames_count":500
   }
}